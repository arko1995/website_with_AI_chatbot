PORT=5000
HOST=127.0.0.1
CLIENT_ORIGIN=http://localhost:5173

# MongoDB used by Express.
MONGODB_URI=mongodb://127.0.0.1:27017/skylinedb3

# Digits only: country code + number, no + sign.
WHATSAPP_NUMBER=19015551234

# Initial admin account. On first startup, if this email does not exist,
# the server creates it using this password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Used to sign admin session cookies. Use a long random value (32+ chars).
SESSION_SECRET=replace-with-a-long-random-session-secret

# Python/FastAPI agent endpoint.
PYTHON_AGENT_URL=http://127.0.0.1:8000/chat
